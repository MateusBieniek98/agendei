# Produto global. Use apenas o nome juridicamente liberado e reservado.
NEXT_PUBLIC_PRODUCT_NAME=Talhivo
NEXT_PUBLIC_PRODUCT_SHORT_NAME=Talhivo
NEXT_PUBLIC_PRODUCT_DESCRIPTION=A operação florestal sob controle, do campo à gestão.
NEXT_PUBLIC_SUPPORT_EMAIL=suporte@example.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacidade@example.com

# Supabase do ambiente atual. Nunca reutilize produção em dev ou staging.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Integrações. O token compartilhado só deve existir durante a migração legada.
SHARED_SYNC_TOKEN=GENERATE_A_LONG_RANDOM_LEGACY_TOKEN
GOOGLE_SHEETS_SYNC_TOKEN=OPTIONAL_LEGACY_DEDICATED_TOKEN
GOOGLE_SHEETS_APONTAMENTOS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
LEGACY_SYNC_ORGANIZATION_SLUG=gn

# Transição local: nunca habilitar em preview, staging ou produção.
ALLOW_LEGACY_SINGLE_TENANT=false
LEGACY_SINGLE_TENANT_NAME=GN Silvicultura

# Rotas de cron e segredos de servidor.
CRON_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_TOKEN
INTEGRATIONS_ENCRYPTION_KEY=GENERATE_32_BYTE_BASE64_KEY

# E-mail e observabilidade (provedores escolhidos na implantação).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=naoresponda@example.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=Talhivo <naoresponda@example.com>
ERROR_MONITORING_DSN=
UPTIME_HEALTHCHECK_URL=
OTEL_SERVICE_NAME=talhivo-local

# Integrações opcionais.
WEBHOOK_URLS=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ti@example.com
