# GN — copie para .env.local. Nunca versione valores reais.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Integração Google Sheets e rotas internas de sincronização.
SHARED_SYNC_TOKEN=GENERATE_A_LONG_RANDOM_TOKEN
GOOGLE_SHEETS_SYNC_TOKEN=OPTIONAL_DEDICATED_TOKEN
GOOGLE_SHEETS_APONTAMENTOS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# A Vercel envia este segredo como Authorization Bearer nas rotas de cron.
CRON_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_TOKEN

# Integrações opcionais.
WEBHOOK_URLS=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ti@example.com
