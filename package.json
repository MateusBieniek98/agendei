{
  "name": "gn-silvicultura",
  "version": "0.1.0",
  "private": true,
  "description": "GN — App de gestão de produção em silvicultura (web + mobile-first)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty false",
    "arch:check": "arch-contract check --config arch-contract.yaml",
    "deadcode": "knip --production --dependencies --files",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration/health-route.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "performance:check": "node scripts/check-performance-budget.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "commitlint": "commitlint",
    "check:source": "npm run lint && npm run typecheck && npm run arch:check && npm run deadcode",
    "check": "npm run check:source && npm run test:coverage && npm run security:audit && npm run build && npm run performance:check && npm run test:e2e",
    "apk:add": "npx cap add android",
    "apk:sync": "npx cap sync android",
    "apk:open": "npx cap open android",
    "apk:build:debug": "JAVA_HOME=\"/Applications/Android Studio.app/Contents/jbr/Contents/Home\" npm run apk:sync && cd android && JAVA_HOME=\"/Applications/Android Studio.app/Contents/jbr/Contents/Home\" ./gradlew assembleDebug",
    "ios:add": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:build:sim": "npm run ios:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator CODE_SIGNING_ALLOWED=NO build",
    "db:reset": "echo 'Ambiente local: aplique lib/db/schema.sql, lib/db/seed.sql e depois supabase/migrations em ordem'"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@opentelemetry/api": "^1.9.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.110.7",
    "@vercel/otel": "^2.1.3",
    "exceljs": "^4.4.0",
    "next": "16.3.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "arch-contract": "^0.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "knip": "^6.37.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@humanfs/node": "0.16.8",
    "@xmldom/xmldom": "0.9.12",
    "baseline-browser-mapping": "2.11.23",
    "browserslist": "4.28.9",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.7"
    }
  }
}
